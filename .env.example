# Copy to .env for local development. Never commit .env.
# Which grader: groq (default, free), anthropic, or fake (ADR 0004).
GRADER=groq
# Groq free tier. Keep the Groq account free of any payment method: that's what makes
# the default grader guaranteed free.
GROQ_API_KEY=
# Only needed with GRADER=anthropic.
ANTHROPIC_API_KEY=
# Salt for hashing IP addresses before they become spend-cap keys (ADR 0003).
IP_HASH_SALT=change-me
